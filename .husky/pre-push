# Pushing to dev or main deploys the live blog (Workers Builds), and CI only
# runs on pull requests, so gate those pushes on a typecheck, a build, the
# bundle budget and the node tests. scripts/pre-push-gate.ts decides what kind
# of push this is (see there); it reads the lines git writes to stdin.
plan=$(bun scripts/pre-push-gate.ts "$@") || exit 1

case "$plan" in
  foreign) exit 0 ;;
esac

bun typecheck

if [ "$plan" = deploy ]; then
  echo "pre-push: checking the shared Fuwari budget, node tests and the selected theme's build"
  selected_theme=$(bun -e 'console.log(process.env.THEME || "default")') || exit 1
  THEME=fuwari bun run build && bun scripts/bundle-report.ts --check && bun run test:node || exit 1
  if [ "$selected_theme" != fuwari ]; then
    THEME="$selected_theme" bun run build || exit 1
  fi
fi
